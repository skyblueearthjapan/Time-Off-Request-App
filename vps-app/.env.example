# 見本。VPS では /opt/kyuka/.env を作り（chmod 600）、値を入れる。.env は git に入れない。
# 必須の値が欠けている・危ない組み合わせのときは api と worker は起動しない（fail-closed）。
# 秘密の値はここに書かず CHANGE_ME だけ置く。手元の控えは C:\Users\imaizumi.LINEWORKS-NET\.secrets\kyuka\。

# staging（切り替えまで）| production（切り替えの日に、オーナーの許可を得てからディレクターが変える）
APP_ENV=staging
PUBLIC_ORIGIN=https://leave.lineworks-local.net
# 出す版のタグ（手元で git rev-parse --short HEAD）。コマンド行ではなくここに書く（罠 24e）
APP_IMAGE_TAG=latest

# DB（db コンテナの中だけで使う。DATABASE_URL は compose がこの 3 つから作る）
POSTGRES_USER=kyuka
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kyuka

# Google ログイン（GCP の OAuth クライアント「Time Off Request (VPS)」）
# 承認済みのリダイレクト URI:
#   https://leave.lineworks-local.net/auth/callback
#   https://leave.lineworks-local.net/auth/google-delegate/callback
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
ALLOWED_DOMAIN=lineworks-local.info

# セッションの署名鍵（32 文字以上の乱数）: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
# ログインの持ち時間（オーナーの決定 K-6: 90 日。無操作でも 90 日は切らない）
SESSION_MAX_AGE_DAYS=90
SESSION_IDLE_HOURS=2160

# 運用者（ops_* と総務管理の運用の欄。SOMU_EMAILS・ADMIN_EMAILS の人も運用者）。委任の開始はこの人だけ。
# 画面の管理者の判定（ADMIN_EMAILS）には足さない。空なら起動しない
BOOTSTRAP_ADMINS=imaizumi@lineworks-local.info

# 委任トークン（スプレッドシート・ドライブ）を暗号化する鍵
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 鍵を変えると保存済みのトークンが読めなくなる（/auth/google-delegate/start から許可し直す）
FERNET_KEY=CHANGE_ME
# GAS の持ち主（委任の持ち主）
DELEGATE_EMAIL=imaizumi@lineworks-local.info

# ===== 業務用の ID と安全装置（読むのは app/config.py だけ。本番の ID はコードの定数と違えば起動しない） =====
# 本番 DB スプレッドシート「休暇届けapp」
PROD_SPREADSHEET_ID=16v1tQNCFkDTk2mnAZ4E2eEdHeUQ2Bepdcsn5vBAmllw
# ステージングの DB（本番 DB の「コピーを作成」で作ったサンドボックス）。staging で必須。本番と同じなら起動しない
STAGING_SPREADSHEET_ID=CHANGE_ME
# マスタ元（作業員マスタの元。読むだけ）
MASTER_SOURCE_SPREADSHEET_ID=1iu5HoaknlW1W1HheeYv0jqcRq-aY0SyEE2seQd2pHkQ
# カレンダー・電子印・部署承認者の読み先（社内カレンダーマスタ・StampMap・DeptApprovers。読むだけ）
CALENDAR_SOURCE_SPREADSHEET_ID=1Knx_kaQMZZams65J1oeSDaBeWUt8XXanNe94XSAHKFQ
# PDF フォルダ（VPS は書かない。internal.ping の照合だけ）。staging では両方必須で、同じなら起動しない
PROD_PDF_FOLDER_ID=1MQibR08wWsE_OGurO9RocEEDGgDOwo-w
STAGING_PDF_FOLDER_ID=CHANGE_ME
# 休暇届台帳（VPS は書かない。GAS が書く）。staging は台帳のコピー
PROD_LEDGER_SPREADSHEET_ID=1B7tnsT4lr80o3pFMBxB2zEhsx2UW2PCL48YTQc9i1eU
STAGING_LEDGER_SPREADSHEET_ID=CHANGE_ME

# ===== GAS の内部用の入口 =====
# 内部用のデプロイの /exec（https://script.google.com/macros/s/<deploymentId>/exec の形）。
# staging はステージングの GAS の写しのデプロイ。画面のデプロイ（@106・@104）はどの環境でも起動しない。
# 本番の GAS のデプロイ（@106・@104・@HEAD）を staging に書くと起動しない
GAS_INTERNAL_URL=https://script.google.com/macros/s/CHANGE_ME/exec
# GAS のスクリプトのプロパティ VPS_INTERNAL_TOKEN と同じ値（32 バイト以上の乱数。staging と本番で別の値）
GAS_INTERNAL_TOKEN=CHANGE_ME
GAS_CALL_TIMEOUT_SECONDS=330
# 呼び方（仕様書 7-1。スパイクで決める）:
#   bearer（第 1 案）: 委任のアクセストークンを Authorization: Bearer で付けて /exec を呼ぶ（Web アプリは access: DOMAIN のまま）
#   anonymous（第 2 案）: 本文の token だけで呼ぶ（内部用のデプロイだけ ANYONE_ANONYMOUS の版）
GAS_INTERNAL_AUTH=bearer
# 本番の内部用の GAS のデプロイの deploymentId（AKfyc…）。作ったら staging・本番の両方の .env に同じ値を書く。
# production: GAS_INTERNAL_URL がこのデプロイでなければ起動しない。staging: GAS_INTERNAL_URL がこれなら起動しない。
# 空なら未設定（切り替えの前提条件）
PROD_GAS_INTERNAL_DEPLOYMENT_ID=

# DB スプレッドシートの時間帯（IANA 名。Sheets API の properties.timeZone を読んで決める。gviz の表示からは GMT の見込み）。
# シートの値と違えば行の反映を止める
DB_SHEET_TIMEZONE=Etc/GMT
# 共有タブ（M_SYSTEM_SETTING・M_LOOKUP）の取り込みの間隔（分）。社内ポータルの URL は M_SYSTEM_SETTING の PORTAL_URL を使う
SHEET_CONFIG_SYNC_MINUTES=5
# シートへ書く前の関所: 合格した gas_ping（本番は GAS の migrated=true も必要）がこの分数より古ければ、
# 行の反映・照合・マスタ同期・集計タブの書き直しはシートへ書かない（管理者の欄に理由が出る）
SHEET_WRITE_PING_MAX_MINUTES=10

# uvicorn が X-Forwarded-* を信じる相手（web コンテナの固定 IP）
FORWARDED_ALLOW_IPS=10.94.0.10

# Cloudflare Tunnel（leave-vps）のトークン。転送先は http://web:80
TUNNEL_TOKEN=CHANGE_ME

# バックアップ（kyuka_*.dump。毎日 3 時。1KB 未満は FAILED）
BACKUPS_HOST_PATH=./backups
BACKUP_KEEP_DAYS=14

# docker のネットワーク（web の IP を固定し、api はその IP からの X-Forwarded-For だけを信じる）
# 変えたら docker compose down → up
KYUKA_NET_SUBNET=10.94.0.0/24
KYUKA_WEB_IP=10.94.0.10
